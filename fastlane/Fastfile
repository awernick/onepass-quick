default_platform(:mac)

APP_NAME = "OnePassQuick"
PROJECT = "#{APP_NAME}.xcodeproj"
SCHEME = APP_NAME

platform :mac do
  desc "Generate Xcode project from project.yml"
  lane :generate do
    sh("cd .. && xcodegen generate")
  end

  desc "Build and sign the app"
  lane :build do
    generate

    # Let Xcode handle signing directly with the Apple Development
    # certificate (set in project.yml). No ad-hoc + re-sign — that
    # two-step process can leave stale metadata that prevents macOS
    # from persisting TCC permissions.
    xcodebuild(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Debug",
      build: true,
    )

    app_path = find_app_path
    UI.user_error!("Could not find built app in DerivedData") unless app_path
    UI.success("Built: #{app_path}")
  end

  desc "Build, sign, and launch the app"
  lane :launch do
    build
    app_path = find_app_path
    sh("open '#{app_path}'")
  end

  desc "Build, sign, and install to /Applications"
  lane :install do
    build

    app_path = find_app_path
    dest = "/Applications/#{APP_NAME}.app"

    # Stop the running app if present
    sh("pkill -x '#{APP_NAME}' || true")
    sleep(1)

    # Remove old install and copy fresh build
    FileUtils.rm_rf(dest)
    FileUtils.cp_r(app_path, dest)
    UI.success("Installed to #{dest}")

    sh("open '#{dest}'")
  end

  desc "Clean build artifacts"
  lane :clean do
    xcclean(project: PROJECT, scheme: SCHEME)
  end
end

def find_app_path
  derived_data = File.expand_path("~/Library/Developer/Xcode/DerivedData")
  app_dir = Dir.glob("#{derived_data}/#{APP_NAME}-*").first
  return nil unless app_dir
  "#{app_dir}/Build/Products/Debug/#{APP_NAME}.app"
end
